<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Employee Properties"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs">
                <items jcr:primaryType="nt:unstructured">
                    <Personal
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Personal Details"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <items jcr:primaryType="nt:unstructured">
                            <name
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                emptyText="eg. John Doe"
                                fieldDescription="Enter Employee Name"
                                fieldLabel="Name"
                                name="./empName"
                                required="{Boolean}true"/>
                            <age
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                emptyText="eg. 20"
                                fieldDescription="Enter Employee Age"
                                fieldLabel="Age"
                                name="./age"/>
                            <phonenumber
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                emptyText="eg. 9100929292"
                                fieldDescription="Enter Employee Phone Number"
                                fieldLabel="Mobile Number"
                                name="./mobNumber"
                                required="{Boolean}true"/>
                        </items>
                    </Personal>
                    <Professional
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Professional Details"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <items jcr:primaryType="nt:unstructured">
                            <company
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                emptyText="eg. IBM"
                                fieldDescription="Enter Employee Company Name"
                                fieldLabel="Company Name"
                                name="./compName"/>
                            <designation
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                emptyText="eg. Project Manager"
                                fieldDescription="Enter Employee Designation Title"
                                fieldLabel="Designation"
                                name="./designation"/>
                        </items>
                    </Professional>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
